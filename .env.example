# ─────────────────────────────────────────────────────────────────
# FlowFi AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to GitHub.
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED: AI Engine (powers the agentic brain) ────────────────
# You can use Anthropic (original) or Google Gemini (recommended for hackathon)
# Gemini API: https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ── REQUIRED: WalletConnect (powers the wallet QR modal) ─────────
# Free at: https://cloud.walletconnect.com → Create Project
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_PROJECT_ID_HERE

# ── REQUIRED: Circle App Kit (powers send, bridge, swap) ──────────
# App Kit uses your MetaMask wallet to sign transactions on Arc.
# Get your Kit Key free: https://console.circle.com → Keys → Kit Keys
# Format: KIT_KEY:your-id:your-secret
# Needed for: USDC ↔ EURC swaps (Arc StableFX)
# Not needed for: simple sends and CCTP bridging
NEXT_PUBLIC_CIRCLE_KIT_KEY=

# ── OPTIONAL: Circle Developer Wallets (server-side agent ops) ────
# Free testnet account at: https://console.circle.com
# Only needed if you want the agent to execute from a server-managed wallet
# (not needed if using MetaMask / App Kit — recommended path)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# ── OPTIONAL: ERC-8004 Agent (filled after npm run register-agent) 
FLOWFI_AGENT_ID=
FLOWFI_OWNER_WALLET=
FLOWFI_VALIDATOR_WALLET=

# ── DEV FLAGS ─────────────────────────────────────────────────────
# Set to true to run without Circle credentials (uses fake tx hashes)
FLOWFI_MOCK_MODE=true
NODE_ENV=development

# ── Rova Execution Log (agent's own contract) ─────────────────────────────
# Deploy contracts/RovaExecutionLog.sol first — see DEPLOY_CONTRACT.md.
# This is the ONLY contract address in this app that's actually unique to
# your build; everything else in lib/config.ts is shared Circle/Arc infra.
NEXT_PUBLIC_ROVA_EXECUTION_LOG_ADDRESS=

# ── Nanopayments rate-shopping (x402 + Circle Gateway) ────────────────────
# Optional — without these, quote-shopping runs in protocol-faithful mock
# mode (still does a real 402 -> pay -> 200 negotiation, just doesn't touch
# live Circle Gateway). Set both to go live:
ROVA_X402_BUYER_PRIVATE_KEY=
ROVA_X402_SELLER_ADDRESS=
